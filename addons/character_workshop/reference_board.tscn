[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://addons/character_workshop/reference_board.gd" id="1"]

[node name="ReferenceBoard" type="VBoxContainer"]
custom_minimum_size = Vector2(0, 165)
size_flags_horizontal = 3
script = ExtResource("1")

[node name="Header" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="Title" type="Label" parent="Header"]
layout_mode = 2
size_flags_horizontal = 3
text = "Character references"
clip_text = true

[node name="AddReferences" type="Button" parent="Header"]
unique_name_in_owner = true
layout_mode = 2
text = "Add images…"

[node name="RemoveReference" type="Button" parent="Header"]
unique_name_in_owner = true
layout_mode = 2
text = "Remove"
disabled = true
tooltip_text = "Remove the reference from this board; the original image stays on disk."

[node name="CloseReferences" type="Button" parent="Header"]
unique_name_in_owner = true
layout_mode = 2
text = "Close"

[node name="ReferenceImages" type="ItemList" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 110)
layout_mode = 2
size_flags_vertical = 3
max_columns = 0
same_column_width = true
fixed_column_width = 135
icon_mode = 0
fixed_icon_size = Vector2i(96, 72)
