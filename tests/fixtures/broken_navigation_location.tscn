[gd_scene format=3]

[ext_resource type="Script" path="res://locations/location.gd" id="location"]
[ext_resource type="PackedScene" path="res://actors/captain_live/captain_live.tscn" id="actor"]

[sub_resource type="NavigationMesh" id="EmptyNavigation"]

[node name="BrokenNavigation" type="Node3D" node_paths=PackedStringArray("camera", "player", "navigation_regions")]
script = ExtResource("location")
camera = NodePath("Camera")
player = NodePath("Captain")
navigation_regions = Array[NodePath]([NodePath("Navigation")])

[node name="Camera" type="Camera3D" parent="."]
current = true

[node name="Captain" parent="." instance=ExtResource("actor")]

[node name="Navigation" type="NavigationRegion3D" parent="."]
navigation_mesh = SubResource("EmptyNavigation")
