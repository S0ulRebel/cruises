extends "res://tests/check.gd"
const Storage = preload("res://addons/character_workshop/mesh_storage.gd")

func _run() -> void:
	var scene_path := "res://ui/portraits/captain_live.tscn"
	var scene: PackedScene = load(scene_path)
	var first: Node = scene.instantiate()
	var second: Node = scene.instantiate()
	var mesh_path: NodePath = first.face_mesh_path
	var a: MeshInstance3D = first.get_node(mesh_path)
	var b: MeshInstance3D = second.get_node(mesh_path)
	check("portrait and fitted assembly stay small text scenes", FileAccess.get_file_as_string(scene_path).length() < 65536 and FileAccess.get_file_as_string("res://ui/portraits/captain_live/assembly.tscn").length() < 65536 and FileAccess.get_file_as_string("res://actors/assembly/templates/captain_portrait.tscn").length() < 65536)
	check("external mesh instances remain independent", a.mesh != b.mesh and a.mesh.resource_local_to_scene and b.mesh.resource_local_to_scene)
	check("materials remain independent across portrait instances", a.mesh.surface_get_material(0) != b.mesh.surface_get_material(0))
	var original_mesh_path := "res://ui/portraits/captain_live/meshes/head.res"
	var original_hash := FileAccess.get_sha256(original_mesh_path)
	var original_arrays := var_to_bytes(a.mesh.surface_get_arrays(0))
	var output := "user://portrait_storage_%d_%d/portrait.tscn" % [OS.get_process_id(), Time.get_ticks_usec()]
	var storage = Storage.new()
	var result: Dictionary = storage.store(first, output)
	check("explicit scene path determines binary mesh outputs", result.ok and result.directory == output.get_basename().path_join("meshes"))
	check("externalization preserves geometry and facial shapes", var_to_bytes(a.mesh.surface_get_arrays(0)) == original_arrays and a.mesh.get_blend_shape_count() == 3)
	check("save leaves original resource file unchanged", FileAccess.get_sha256(original_mesh_path) == original_hash)
	check("live mesh keeps its new explicit external path", a.mesh.resource_path.begins_with(result.directory) and a.mesh.resource_path.ends_with(".res"))
	var output_mesh: Mesh = ResourceLoader.load(a.mesh.resource_path, "Mesh", ResourceLoader.CACHE_MODE_IGNORE)
	check("cold binary mesh retains local state and deformation", output_mesh.resource_local_to_scene and output_mesh.get_blend_shape_count() == 3 and var_to_bytes(output_mesh.surface_get_arrays(0)) == original_arrays)
	var packed := PackedScene.new()
	check("fixture packs authored portrait without a builder", packed.pack(first) == OK)
	check("fixture saves only to its explicit output", ResourceSaver.save(packed, output) == OK)
	var repeated: Dictionary = storage.store(first, output)
	check("ordinary save can update only its referenced resource files", repeated.ok)
	var other_output := output.get_base_dir().path_join("collision.tscn")
	var other_storage = Storage.new()
	other_storage._collect_nodes(second, second)
	var collision_dir := other_output.get_basename().path_join("meshes")
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(collision_dir))
	var collision := collision_dir.path_join(other_storage._meshes[0].name + ".res")
	var sentinel := FileAccess.open(collision, FileAccess.WRITE)
	sentinel.store_string("Preserve unrelated resource")
	sentinel.close()
	var sentinel_hash := FileAccess.get_sha256(collision)
	var rejected: Dictionary = other_storage.store(second, other_output)
	check("unrelated existing resources reject before overwriting", not rejected.ok and FileAccess.get_sha256(collision) == sentinel_hash)
	first.free()
	second.free()
	finish()
