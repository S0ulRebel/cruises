combinations = {
"brass_inkwell": {
"say": "He holds the inkwell over the bowl. Count Fingers does not blink, because he cannot, but the intent is there."
},
"compass": {
"say": "The needle swings towards the fish and stays there. Livé decides not to think about that."
}
}
