description = "Stencilled LE CHAOS NAVIGUE TOUJOURS PLUS LOIN. Nailed shut."
refusal = "It is nailed shut, and the captain is not going to use his fingers."
combinations = {
"brass_inkwell": {
"say": "He considers prising the lid with an inkwell, and his hand stops before his pride does."
},
"compass": {
"say": "He holds the compass to the crate. The needle, loyal to nothing, points at the crate."
},
"fishbowl": {
"say": "Count Fingers regards the crate. The crate, being a crate, does not regard him back."
},
"rapier": {
"gives": "key",
"say": "The lid comes up with a noise like a small argument. Inside: a key, and three years of damp.",
"sets": "crate_open",
"solved": true
}
}
