; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Cruises"
config/description="A point-and-click comedy adventure. Pirates, a cruise ship, and a crack in space and time."
run/main_scene="res://game/game.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[navigation]

; The navigation MAP and the baked navigation MESH must agree on cell size, or the
; rasterised mesh edges do not line up with the map and paths come back empty. The
; default map is 0.25 m, which is far too coarse for a room where a character has to
; walk between a desk and a wall. Set here rather than per mesh so every room matches
; the map by default. Authored NavigationMesh resources use the same numbers.
3d/default_cell_size=0.1
3d/default_cell_height=0.1

[input]

dialogue_continue={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32), Object(InputEventKey,"physical_keycode":4194309)]
}
inventory_toggle={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":73)]
}
game_quit={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
