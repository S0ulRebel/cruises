text_overrun_behavior = 3

[node name="ReferenceHint" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
clip_text = true
text = "Choose an image to show beside the character. Project images can be dropped here."
modulate = Color(0.68, 0.73, 0.79, 1)

[node name="ReferenceFiles" type="FileDialog" parent="."]
unique_name_in_owner = true
title = "Add character reference images"
size = Vector2i(850, 550)
file_mode = 1
access = 2
filters = PackedStringArray("*.png, *.jpg, *.jpeg, *.webp ; Reference images")
